# ---- Auth -------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
# Sign session cookies. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-hex-string

# ---- GitHub -----------------------------------------------------------------
# Fine-grained PAT, read-only: Contents + Metadata (+ private repos you want).
# Classic PAT: 'repo' scope covers private repos.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ---- Paths (inside the container; map to the NAS in docker-compose.yml) ------
MIRROR_ROOT=/data/mirrors
PROTECTION_ROOT=/data/protection
DB_PATH=/data/repo-ripper.db

# Timezone for cron schedules, e.g. America/Denver
TZ=UTC

# ---- Seed defaults (editable later in the UI) -------------------------------
INCLUDE_FORKS=true
INCLUDE_ARCHIVED=true
INCLUDE_WIKIS=true
FETCH_LFS=true
PROTECTION_DELETE=true

# Telegram (optional; can also be set in the UI)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ON_SUCCESS=true
NOTIFY_ON_FAIL=true

# Cron: minute hour day month weekday
SCHEDULE_SCAN=0 3 * * *
SCHEDULE_PULL=30 3 * * *
SCHEDULE_PROTECTION=0 5 * * 0
