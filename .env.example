# ---- Auth -------------------------------------------------------------------
ADMIN_USERNAME=admin
# The app refuses to start while ADMIN_PASSWORD or SECRET_KEY is a placeholder.
ADMIN_PASSWORD=change-me-now
# Signs session cookies and encrypts the GitHub token that the UI stores.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Keep this value. If it changes, you must enter the GitHub token again.
SECRET_KEY=replace-with-a-long-random-hex-string

# ---- GitHub -----------------------------------------------------------------
# Optional. The normal way is to enter the token in the UI (setup wizard or
# Settings); the app stores it encrypted. A token set here is used only when
# no token is stored in the UI.
# Fine-grained PAT, read-only: Contents, Metadata, Issues, Pull requests
# (+ the private repos you want).
# Classic PAT: 'repo' scope covers private repos.
GITHUB_TOKEN=

# ---- Paths (inside the container) -------------------------------------------
# Folders that the folder browser in the UI can show (comma-separated). The
# mirror folder and the protection folder that you select must be inside one
# of them. /mnt/nas from docker-compose.yml is below /mnt.
BROWSE_ROOTS=/mnt,/data
# Fallback values. The folders that you select in the UI replace them.
MIRROR_ROOT=/data/mirrors
PROTECTION_ROOT=/data/protection
DB_PATH=/data/repo-ripper.db

# Timezone for cron schedules, e.g. America/Denver
TZ=UTC

# ---- Seed defaults (editable later in the UI) -------------------------------
INCLUDE_FORKS=true
INCLUDE_ARCHIVED=true
INCLUDE_WIKIS=true
FETCH_LFS=true
AUTO_ENABLE_NEW=true
PROTECTION_DELETE=true

# Telegram (optional; can also be set in the UI)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ON_SUCCESS=true
NOTIFY_ON_FAIL=true

# Cron: minute hour day month weekday
SCHEDULE_SCAN=0 3 * * *
SCHEDULE_PULL=30 3 * * *
SCHEDULE_PROTECTION=0 5 * * 0
